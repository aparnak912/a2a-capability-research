# local (default) or agentcore. No secrets in this file.
A2A_TARGET=local

# Local listen address. AgentCore ignores these and uses 0.0.0.0:9000
# unless you set them yourself.
A2A_HOST=127.0.0.1
A2A_PORT=8123

# Local SQLite file. On the AgentCore runtime set this to /mnt/efs/a2a_tasks.db
A2A_DB_PATH=data/a2a_tasks.db

# Used only when A2A_TARGET=agentcore. Leave the ARN empty until deploy.
AWS_REGION=us-west-2
AGENTCORE_RUNTIME_ARN=
